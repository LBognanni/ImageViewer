<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImageViewer"
        x:Class="ImageViewer.SettingsDialog"
        Title="Preferences"
        Width="460"
        Height="430"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <!-- A fixed height, so that the window doesn't jump between tabs -->
  <Grid Margin="16" RowDefinitions="*,Auto">
    <TabControl>
      <TabItem Header="General">
        <!-- Labels in one column and controls in the other, which is as wide as the widest control,
             so the left and right edges of the controls line up -->
        <Grid Margin="0,16" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="16" RowSpacing="12" HorizontalAlignment="Left">
          <Grid.Styles>
            <Style Selector="Grid > TextBlock">
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </Grid.Styles>

          <TextBlock Text="Window" />
          <CheckBox x:Name="FullScreen" Grid.Column="1" Content="Start in full screen" />

          <TextBlock Grid.Row="1" Text="Default zoom" />
          <ComboBox x:Name="Zoom" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Fit to screen" />
            <ComboBoxItem Content="Actual size" />
          </ComboBox>

          <Button x:Name="MakeDefault" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Content="Set as default image viewer" />
        </Grid>
      </TabItem>
      <TabItem Header="About">
        <local:AboutPanel x:Name="About" Margin="0,12" />
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="Ok" Content="Ok" IsDefault="True" MinWidth="80" HorizontalContentAlignment="Center" />
      <Button x:Name="Cancel" Content="Cancel" IsCancel="True" MinWidth="80" HorizontalContentAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
